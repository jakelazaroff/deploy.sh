# Manage SSH deploy keys for an app
#
# To add this plugin, copy this file to $DEPLOY_ROOT/.plugins/keys

COMMANDS[keys]=cmd:keys
cmd:keys() {
	local subcmd="${1:-list}"; shift 2>/dev/null || true
	case "$subcmd" in
		list)     keys:list "$@" ;;
		add)      keys:add "$@" ;;
		remove)   keys:remove "$@" ;;
		generate) keys:generate "$@" ;;
		*)        die "Usage: deploy keys [list|add|remove|generate] <app> [key-name]" ;;
	esac
}

_key_fingerprint() {
	echo "$1" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}'
}

keys:list() {
	require_app "${1:-}"
	local auth_keys="/home/$DEPLOY_USER/.ssh/authorized_keys"
	local found=false
	while IFS= read -r line; do
		[[ "$line" != *" deploy:$app_name:"* ]] && continue
		found=true
		local raw_key="${line#*no-pty }"
		local key_name="${raw_key##*deploy:"$app_name":}"
		printf "%-24s  %s\n" "$key_name" "$(_key_fingerprint "$raw_key")"
	done < "$auth_keys"
	$found || log "(no deploy keys for $app_name)"
}

keys:add() {
	require_app "${1:-}"
	local auth_keys="/home/$DEPLOY_USER/.ssh/authorized_keys"
	require_arg "${2:-}" "Usage: deploy keys add <app> <key-name> [public-key]"
	local key_name=$2 pubkey="${3:-}"
	[ -z "$pubkey" ] && read -r pubkey
	[ -z "$pubkey" ] && die "No public key provided"
	local keytype keydata _rest
	read -r keytype keydata _rest <<< "$pubkey"
	local normalized="$keytype $keydata deploy:$app_name:$key_name"
	local entry="command=\"git-receive-pack '$app_dir/repo.git'\",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty $normalized"
	echo "$entry" >> "$auth_keys"
	success "Added deploy key '$key_name' for $app_name: $(_key_fingerprint "$normalized")"
}

keys:remove() {
	require_app "${1:-}"
	local auth_keys="/home/$DEPLOY_USER/.ssh/authorized_keys"
	require_arg "${2:-}" "Usage: deploy keys remove <app> <key-name>"
	local key_name=$2
	local tmpfile; tmpfile=$(mktemp)
	local found=false
	while IFS= read -r line; do
		if [[ "$line" == *" deploy:$app_name:$key_name" ]]; then
			found=true; continue
		fi
		echo "$line" >> "$tmpfile"
	done < "$auth_keys"
	if $found; then
		mv "$tmpfile" "$auth_keys"
		success "Removed deploy key '$key_name' from $app_name"
	else
		rm -f "$tmpfile"
		die "Key '$key_name' not found for $app_name"
	fi
}

keys:generate() {
	require_app "${1:-}"
	local auth_keys="/home/$DEPLOY_USER/.ssh/authorized_keys"
	require_arg "${2:-}" "Usage: deploy keys generate <app> <key-name>"
	local key_name=$2
	local tmpdir; tmpdir=$(mktemp -d)
	local keyfile="$tmpdir/key"
	ssh-keygen -t ed25519 -f "$keyfile" -N "" -C "deploy:$app_name:$key_name" >/dev/null 2>&1
	local pubkey; pubkey=$(cat "$keyfile.pub")
	local keytype keydata _rest
	read -r keytype keydata _rest <<< "$pubkey"
	local normalized="$keytype $keydata deploy:$app_name:$key_name"
	local entry="command=\"git-receive-pack '$app_dir/repo.git'\",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty $normalized"
	echo "$entry" >> "$auth_keys"
	success "Generated deploy key '$key_name' for $app_name: $(_key_fingerprint "$normalized")" >&2
	log "" >&2
	cat "$keyfile"
	rm -rf "$tmpdir"
}
